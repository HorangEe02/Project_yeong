# Firebase 프로젝트: ajin-cb (project number: 614046190602)
# 이 파일을 .env.development.local 로 복사 후 Firebase Console에서 받은 값으로 채우세요.
# Console: https://console.firebase.google.com/project/ajin-cb/overview

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ajin-cb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ajin-cb
VITE_FIREBASE_DATABASE_URL=https://ajin-cb-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=ajin-cb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=614046190602
VITE_FIREBASE_APP_ID=

# 비용 차단 기본값: legacy Firebase 직접 write 금지, read fallback만 임시 허용.
VITE_FIREBASE_WRITE_ENABLED=false
VITE_FIREBASE_READ_FALLBACK_ENABLED=true

# Mock 모드 (Firebase 키 채우기 전까지 true 유지)
VITE_USE_MOCK=true

# 백엔드 (사내 FastAPI + Cloudflare Tunnel)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_PROXY_TARGET=http://localhost:8000
