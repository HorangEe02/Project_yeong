  "terms": {
    "PO": "Purchase Order - 구매발주서 (발주 핵심 문서)",
    "견적": "RFQ - Request for Quotation (견적요청)",
    "ECR": "Engineering Change Request - 설계변경요청",
    "ECN": "Engineering Change Notice - 설계변경통보",
    "SQ": "Supplier Quality - 협력사 품질 관리",
    "SRM": "Supplier Relationship Management - 협력사 관계관리",
    "VMI": "Vendor Managed Inventory - 공급자 관리 재고",
    "JIT": "Just In Time - 적시 납품",
    "단가": "Unit Price - 단위 가격 (원가 절감 핵심)",
    "발주": "Purchase Order Issuance - 발주 실행",
    "입찰": "Bidding - 경쟁 입찰",
    "소싱": "Sourcing - 공급처 선정",
    "AP": "Advanced Purchasing - 선구매",
    "Global Sourcing": "글로벌 소싱 (해외 조달)",
    "원가 분석": "Cost Analysis - 원가 분석 (단가 협상 기반)"
  }
