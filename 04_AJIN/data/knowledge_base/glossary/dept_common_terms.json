{
  "citation_id": "GLOSSARY-dept_common_terms",
  "owner_department": "총무인사팀",
  "reviewed_at": "2026-05-21",
  "effective_date": "2026-05-21",
  "status": "published",
  "category": "부서 공통 현장 은어·관용 표현",
  "department": ["전 부서 공통"],
  "version": "1.0",
  "description": "자동차 부품 제조업 전체에서 부서에 관계없이 일상적으로 사용하는 현장 은어, 관용 표현, 일본어 유래 용어 모음. 신입사원이 현장에서 가장 먼저 접하게 되는 표현들이다.",
  "terms": [
    {"term": "현품", "full_name": "現品 (현물 제품)", "definition": "실제 제품 현물. 도면이나 데이터가 아닌 실물을 지칭한다.", "usage_example": "\"현품 확인했어?\" = 실제 제품 봤어?", "aliases": ["현물", "실물"]},
    {"term": "이슈", "full_name": "Issue (문제/현안)", "definition": "해결해야 할 문제나 논의가 필요한 사항.", "usage_example": "\"이슈 있다\" = 문제가 생겼다, \"이슈 리스트 정리해\"", "aliases": ["문제", "현안"]},
    {"term": "데드라인", "full_name": "Deadline (마감 기한)", "definition": "업무·문서·납품 등의 최종 완료 기한.", "usage_example": "\"데드라인 언제야?\"", "aliases": ["마감일", "기한", "D-Day"]},
    {"term": "피드백", "full_name": "Feedback (검토 의견/수정사항)", "definition": "보고서, 문서, 결과물에 대한 검토 후 보완·수정 요청 사항.", "usage_example": "\"피드백 주세요\", \"피드백 반영했습니다\"", "aliases": ["검토의견", "F/B"]},
    {"term": "아사이", "full_name": "Assign (업무 배정)", "definition": "특정 업무나 역할을 담당자에게 배정하는 것.", "usage_example": "\"이 건 김 대리한테 아사인해\" = 김 대리에게 업무 배정해", "aliases": ["어사인", "배정"]},
    {"term": "4M 변경", "full_name": "Man / Machine / Material / Method", "definition": "사람(Man), 설비(Machine), 자재(Material), 공법(Method) 4가지 생산 요소의 변경. 4M 변경 시 반드시 품질 영향을 평가하고 고객 승인을 받아야 한다.", "usage_example": "\"4M 변경 신고해\" = 생산 요소 변경을 고객에 통보해", "aliases": ["포엠", "4M관리"]},
    {"term": "다시", "full_name": "再 (다시/재)", "definition": "검수 후 재작업이 필요한 상태. 또는 확인을 다시 하라는 의미.", "usage_example": "\"다시 해\" = 재작업해, \"다시 봐\" = 다시 확인해", "aliases": ["재작업"]},
    {"term": "OK / NG", "full_name": "OK (합격) / NG (Not Good, 불합격)", "definition": "제품이나 검사 결과의 합격/불합격 판정. NG는 일본 제조업에서 시작되어 한국에서도 널리 사용된다.", "usage_example": "\"이거 OK야 NG야?\" = 합격이야 불합격이야?", "aliases": ["오케이/엔지", "합격/불합격"]},
    {"term": "출하 걸렸다", "full_name": "Shipment Hold (출하 보류)", "definition": "출하 검사에서 불합격 처리되어 고객에게 보낼 수 없는 상태.", "usage_example": "\"출하 걸렸다\" = 출하 검사 불합격됐다", "aliases": ["출하보류", "출하정지"]},
    {"term": "워킹데이", "full_name": "Working Day (영업일)", "definition": "주말·공휴일을 제외한 실제 근무일. 납기나 기한을 영업일 기준으로 산정한다.", "usage_example": "\"5워킹데이 이내\" = 영업일 기준 5일 이내", "aliases": ["영업일", "근무일"]},
    {"term": "수평전개", "full_name": "Horizontal Deployment / Yokoten (横展)", "definition": "한 공정이나 제품에서 발견된 문제·개선사항을 유사한 다른 공정·제품에도 동일하게 적용하는 것.", "usage_example": "\"이 개선 사례 다른 라인에도 수평전개해\"", "aliases": ["요코텐", "횡전개"]},
    {"term": "라인", "full_name": "Production Line (생산라인)", "definition": "제품을 순서대로 생산하는 일련의 공정 설비 배열. 프레스라인, 용접라인, 조립라인 등으로 구분한다.", "usage_example": "\"몇 번 라인이야?\", \"라인 멈췄다\"", "aliases": ["생산라인"]},
    {"term": "도면대로", "full_name": "As per Drawing", "definition": "설계 도면에 명시된 사양·치수대로 만들라는 의미. 현장에서 가장 기본이 되는 원칙.", "usage_example": "\"도면대로 안 된다\" = 설계와 실제 결과가 다르다", "aliases": ["도면 기준"]},
    {"term": "기다려", "full_name": "Wait / Pending", "definition": "자재 대기, 결재 대기, 고객 응답 대기 등 진행이 멈춘 상태.", "usage_example": "\"자재 기다려\" = 자재 입고 대기 중", "aliases": ["대기", "펜딩"]},
    {"term": "만땅", "full_name": "滿(만) + Tank(탱크)의 일본식 발음", "definition": "가득 찬 상태. 한자 '滿' + 영어 'Tank'의 일본식 발음 '탕크→땅'이 합쳐진 3개국어 혼합 은어.", "usage_example": "\"재고 만땅이야\" = 재고가 가득 찼다", "aliases": ["풀", "가득"]},
    {"term": "엔지", "full_name": "NG (Not Good, 불합격)", "definition": "불합격, 부적합을 뜻하는 일본 제조업 유래 용어. 전 세계 제조 현장에서 통용된다.", "usage_example": "\"엔지 났다\" = 불량이 발생했다", "aliases": ["NG", "불합격", "불량"]},
    {"term": "개선", "full_name": "Kaizen (改善, 카이젠)", "definition": "지속적으로 작은 개선을 반복하는 일본식 품질 경영 철학. 제안 제도, QC서클 활동 등으로 실천한다.", "usage_example": "\"개선 활동 해\", \"개선 제안 올려\"", "aliases": ["카이젠", "KAIZEN", "지속적 개선"]},
    {"term": "3정 5S", "full_name": "3定 5S (정리·정돈·청소·청결·습관화)", "definition": "3정(정품, 정량, 정위치)과 5S(정리/정돈/청소/청결/습관화)를 합친 현장 관리 기본 활동. 도요타 생산방식의 기초.", "usage_example": "\"5S 활동 하자\", \"3정 5S 안 되어 있다\"", "aliases": ["오에스", "5S활동"]},
    {"term": "보고드립니다", "full_name": "(보고 관용구)", "definition": "메일이나 보고서에서 '~에 대해 보고드립니다'로 시작하는 제조업 보고 문화의 관용 표현.", "usage_example": "\"금일 품질 현황에 대해 보고드립니다\"", "aliases": []},
    {"term": "공유드립니다", "full_name": "(공유 관용구)", "definition": "정보나 결과를 관련자에게 전달할 때 사용하는 비즈니스 한국어 관용 표현.", "usage_example": "\"아래 내용 공유드립니다\"", "aliases": []}
  ]
}
