# ════════════════════════════════════════════════════════════
# AJIN Compliance — Docker Compose 전용 env override
# ════════════════════════════════════════════════════════════
# 사용법:
#   cp .env.docker.example .env.docker
# docker-compose 가 .env + .env.docker 둘 다 로드 (.env.docker 우선).
# .env 의 값을 컨테이너 환경에 맞게 덮어쓰기 위해 분리.

# ── Phase 1 — Mac 호스트 Ollama (Metal GPU 활용) ──────────────
# 컨테이너 안 backend 가 호스트의 Ollama 에 접근.
# Mac/Windows Docker Desktop 은 host.docker.internal 자동.
# Linux 는 docker-compose.yml 의 extra_hosts: host-gateway 로 해결.
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_ROUTER_PRIMARY=ollama
EMBEDDING_BACKEND=ollama
FEATURE_B_BLOCK_GEMINI=true
OLLAMA_MODEL_CHAT_LARGE=qwen3.5:9b
OLLAMA_MODEL_CHAT_SMALL=qwen3.5:4b
OLLAMA_MODEL_GEMMA_LARGE=gemma4:e4b
OLLAMA_MODEL_GEMMA_SMALL=gemma4:e2b
OLLAMA_MODEL_EMBEDDING=bge-m3

# Host Ollama model root. This value is for the host setup script, not for
# containers. The correct root contains both blobs/ and manifests/.
OLLAMA_MODELS_ROOT=<EXTERNAL_DRIVE>/.ollama/models

# ── Phase 1.5 / Phase 2 — NVIDIA GPU 컨테이너로 swap ─────────
# docker-compose.yml 의 ollama service 활성화 후 아래로 변경:
# OLLAMA_BASE_URL=http://ollama:11434

# ── Phase 2 — 모델별 분리 (LLM 풀) ────────────────────────────
# 미설정 시 OLLAMA_BASE_URL 로 자동 폴백 → Phase 1 동작 유지 (backward-compatible).
# NVIDIA 서버 / Cloud Run 컨테이너 분리 시 활성화.
# Endpoint 분리:
# OLLAMA_BASE_URL_LARGE=http://ollama-large:11434
# OLLAMA_BASE_URL_FAST=http://ollama-fast:11434
# 모델 override (config.py LLM_FEATURE_ROUTES 기본값과 매핑):
# LLM_MODEL_WHATIF=qwen3.5:9b   # whatif 자연어 라우팅 (LARGE)
# LLM_MODEL_QUIZ=gemma4:e2b     # 학습 퀴즈 생성 (FAST)
# LLM_MODEL_RAG=qwen3.5:4b      # RAG 답변 (FAST)
# LLM_MODEL_GRADE=qwen3.5:4b    # 단답형 채점 (FAST)

# ── Phase B — Vertex AI Gemini 통합 ────────────────────────────
# LLM_PROVIDER=vertex 면 4 feature 모두 Vertex 로 라우팅 (1줄 swap).
# VERTEX_PROJECT_ID 미설정 시 Ollama 자동 폴백 (Stage 1 호환).
# LLM_PROVIDER=vertex
# VERTEX_PROJECT_ID=ajin-compliance
# VERTEX_LOCATION=asia-northeast3
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/ajin-sa-key.json
# 모델 override (Vertex 활성 시 자동 default = gemini-2.0-flash):
# LLM_MODEL_WHATIF=gemini-2.0-flash    # 또는 gemini-2.5-pro (whatif 정확도 우선 시)
# LLM_MODEL_QUIZ=gemini-2.0-flash
# LLM_MODEL_RAG=gemini-2.0-flash
# LLM_MODEL_GRADE=gemini-2.0-flash

# ── Redis (LLM 응답 cache, idempotent) ────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Phase 3 — PostgreSQL 마이그 ──────────────────────────────
# POSTGRES_URL=postgresql://ajin:${POSTGRES_PASSWORD}@postgres:5432/ajin
# POSTGRES_PASSWORD=

# ── Phase 4 — Supabase pgvector 전환 ─────────────────────────
# chroma: 기존 Chroma/BM25 유지, dual: Chroma+Postgres 동시 적재,
# postgres: Supabase pgvector만 적재. read 전환 전에는 dual로 비교한다.
VECTOR_WRITE_MODE=chroma
VECTOR_READ_MODE=chroma
VECTOR_EMBEDDING_MODEL=bge-m3
VECTOR_EMBEDDING_DIM=1024
VECTOR_EMBEDDING_VERSION=v1

# ── 기타 ─────────────────────────────────────────────────────
# 운영용 로그 레벨 (개발=info / 운영=warning)
LOG_LEVEL=info

# Backend 내부 port (Dockerfile EXPOSE 8080 와 동일, compose rp 가 8080→80)
PORT=8080
