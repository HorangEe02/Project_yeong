# AJIN AI Assistant — 환경변수 예시 (.env.example)
# 실제 배포 시 .env 또는 secret manager 로 주입.

# ── v4.7 Feature E — 외부 IdP (OIDC) ──
# 기본 disabled — 머지 직후 기존 로그인 흐름 무변경.
# 옵션: disabled | oidc | saml(Phase 4 stub) | ldap
IDP_PROVIDER=disabled
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── v4.7 Feature E — SAML 2.0 (python3-saml / OneLogin toolkit) ──
# IDP_PROVIDER=saml 활성 시 사용. HTTP-Redirect binding + ACS POST endpoint.
SAML_IDP_METADATA_URL=
SAML_SP_ENTITY_ID=
SAML_SP_ACS_URL=
SAML_X509_CERT_PATH=

# ── v4.7 Feature E — LDAP / Active Directory (direct-bind) ──
# IDP_PROVIDER=ldap 활성 시 사용. POST /auth/idp/ldap/login form endpoint.
LDAP_SERVER_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE_DN=ou=people,dc=ajin,dc=co,dc=kr
LDAP_GROUP_BASE_DN=ou=groups,dc=ajin,dc=co,dc=kr
LDAP_USER_FILTER=(uid={username})

# ── v4.7 Feature E — 세션/state 저장소 ──
# memory: 단일 인스턴스 dev/CI
# redis : Cloud Run + Memorystore (운영)
SESSION_STORE=memory
REDIS_URL=redis://localhost:6379/0

# ── v4.7 Feature E Phase 2 — 2FA TOTP ──
# Fernet 키 — `cryptography.fernet.Fernet.generate_key()` 로 생성 후 주입.
# 비어 있으면 2FA enroll/verify 시 부팅 검증에서 ValueError.
TOTP_SECRET_FERNET_KEY=

# ── v4.8 Feature F 트랙 A — 실시간 PLC + Vision OCR ──
# Redis Stream key prefix — 라인별 stream 은 `<prefix><line_id>` (e.g. plc:lane:L01)
PLC_REDIS_STREAM_KEY_PREFIX=plc:lane:
# Consumer group 이름 — `equipment_spc_consumers` (기본)
PLC_CONSUMER_GROUP=equipment_spc_consumers

# Firebase Admin SDK — backend → RTDB push 용. 둘 다 설정되어야 라이브 모드.
# 비용 차단 기본값: 신규 Firestore/RTDB/Storage write는 비활성.
FIREBASE_WRITE_ENABLED=false
# 임시 fallback: 기존 Firebase read 경로만 허용. cutover 후 false 전환.
FIREBASE_READ_FALLBACK_ENABLED=true
# RTDB write 차단 또는 미설정 시 로컬 캡처 파일을 남길지 여부.
FIREBASE_DRYRUN_CAPTURE_ENABLED=true
# 비어있으면 dry-run 모드 (data/captures/rtdb_dryrun/ 에 캡처).
FIREBASE_ADMIN_CREDENTIALS_JSON=
FIREBASE_DATABASE_URL=

# Gemini Vision API — 도면 OCR 파일럿. 미설정 시 RuntimeError("vision_disabled").
# (이미 search/vision_query.py 에서 사용 중 — 키 공유)
# GEMINI_API_KEY=

# ── v4.8 Feature F 트랙 B — Management 콘솔 (Audit/System) ──
# Firestore audit_logs shadow 쓰기/조회 토글. 기본 false (no-op).
# true 로 활성 시 firebase_admin 초기화 필요 + Firestore quota 모니터링 필수.
FIRESTORE_AUDIT_ENABLED=false
# 일일 audit 쓰기 상한 (운영자 alert 기준). 실제 차단은 별도 모니터링 잡 책임.
FIRESTORE_AUDIT_MAX_PER_DAY=5000

# ── Firebase → Supabase/PostgreSQL 전환 ──
# sqlite: 기존 기능별 SQLite 유지, postgres: DATABASE_URL 기반 Postgres 사용.
APP_DB_BACKEND=sqlite
DATABASE_URL=
# 운영 기본 관리자 bootstrap은 명시적으로 켠 경우에만 허용한다.
AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
# Supabase secret/service_role 계열 키는 브라우저에 노출하지 않는다.
SUPABASE_PROJECT_REF=ycjuzwltwbeudanjykag
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# ── Supabase pgvector / Chroma 전환 ──
# 초기값은 기존 동작 보존. pgvector 인덱스 비교 단계에서 dual로 전환한다.
VECTOR_WRITE_MODE=chroma
VECTOR_READ_MODE=chroma
VECTOR_EMBEDDING_MODEL=bge-m3
VECTOR_EMBEDDING_DIM=1024
VECTOR_EMBEDDING_VERSION=v1
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=ajin-attachments
SUPABASE_STORAGE_BUCKET_DRAFT_EXPORTS=ajin-draft-exports
ENABLE_SUPABASE_REALTIME=false
SMOKE_ADMIN_JWT=

# ── Frontend build-time public env ──
# VITE_* 값은 Vite 번들에 포함되므로 secret을 넣지 않는다.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8000
