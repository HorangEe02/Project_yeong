{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ajin-backend-614046190602.asia-northeast3.run.app/api/:path*"
    },
    {
      "source": "/((?!assets/|logos/|fonts/|drawings/|favicon\\.ico|robots\\.txt|sitemap\\.xml|.*\\..+).*)",
      "destination": "/index.html"
    }
  ]
}
