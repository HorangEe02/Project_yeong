# AJIN AI Assistant — Development Environment
# 개발 모드: Mock API 사용 (백엔드 없이 데모 가능)

VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_PROXY_TARGET=http://localhost:8000

# Firebase (Day 2 Firebase 콘솔 생성 후 채울 것 — `.env.development.local` 권장)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=ajin-ai-assistant.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=ajin-ai-assistant
# VITE_FIREBASE_DATABASE_URL=
# VITE_FIREBASE_STORAGE_BUCKET=ajin-ai-assistant.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Firebase → Supabase/Postgres 전환 기본값.
VITE_FIREBASE_WRITE_ENABLED=false
VITE_FIREBASE_READ_FALLBACK_ENABLED=true
