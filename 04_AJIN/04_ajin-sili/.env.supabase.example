# AJIN Firebase -> Supabase cutover env template.
# Copy to .env.supabase.local or inject through CI/Cloud Run Secret Manager.
# Do not commit .env.supabase.local.

SUPABASE_PROJECT_REF=ycjuzwltwbeudanjykag
SUPABASE_URL=https://ycjuzwltwbeudanjykag.supabase.co

# Supabase dashboard account token. Must start with sbp_.
SUPABASE_ACCESS_TOKEN=

# Supabase Postgres connection string and DB password.
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Backend-only elevated key. Prefer sb_secret_... over legacy service_role JWT.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# AJIN runtime cutover posture.
APP_DB_BACKEND=postgres
FIREBASE_WRITE_ENABLED=false
FIREBASE_READ_FALLBACK_ENABLED=false

# Private buckets used by backend/services/supabase_storage.py.
SUPABASE_STORAGE_BUCKET_ATTACHMENTS=ajin-attachments
SUPABASE_STORAGE_BUCKET_DRAFT_EXPORTS=ajin-draft-exports
ENABLE_SUPABASE_REALTIME=false
