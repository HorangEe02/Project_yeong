{
  "rules": {
    "users": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && auth.uid === $uid))"
        },
        "status": {
          ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && auth.uid === $uid))"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists() && auth.uid === $uid"
        }
      }
    },
    "staff_codes": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.child('usedBy').exists() && newData.child('usedBy').val() === auth.uid) || auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "sessions": {
      "$sessionId": {
        ".write": "auth != null",
        ".read": "auth != null && (data.child('staffUid').val() === auth.uid || data.child('patientUid').val() === auth.uid || auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "qr_tokens": {
      "$token": {
        ".write": "auth != null",
        ".read": "auth != null"
      }
    },

    "hospital_index": {
      ".read": "auth != null",
      "$hospitalId": {
        ".write": "auth != null && auth.token.role === 'platformAdmin'",
        "slug": { ".validate": "newData.isString() && newData.val() === $hospitalId" },
        "name": { ".validate": "newData.isString()" },
        "themeColor": { ".validate": "newData.isString()" },
        "contractStatus": { ".validate": "newData.val() === 'active' || newData.val() === 'pilot' || newData.val() === 'paused'" }
      }
    },

    "hospitals": {
      "$hospitalId": {
        "profile": {
          ".read": "auth != null",
          ".write": "auth != null && auth.token.role === 'platformAdmin'"
        },
        "floor-plans": {
          ".read": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('primaryHospitalId').val() === $hospitalId)",
          ".write": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.hospitalId === $hospitalId && auth.token.role === 'admin'))"
        },
        "pois": {
          ".read": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('primaryHospitalId').val() === $hospitalId)",
          ".write": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.hospitalId === $hospitalId && auth.token.role === 'admin'))"
        },
        "departments": {
          ".read": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('primaryHospitalId').val() === $hospitalId)",
          ".write": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.hospitalId === $hospitalId && auth.token.role === 'admin'))"
        },
        "announcements": {
          ".read": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('primaryHospitalId').val() === $hospitalId)",
          ".indexOn": ["startAt"],
          "$id": {
            ".write": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.hospitalId === $hospitalId && (auth.token.role === 'admin' || auth.token.role === 'staff')))"
          }
        },
        "appointments": {
          ".indexOn": ["scheduledAt", "patientUid"],
          "$apptId": {
            ".read": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.hospitalId === $hospitalId && (data.child('patientUid').val() === auth.uid || auth.token.role === 'staff' || auth.token.role === 'admin')))",
            ".write": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.hospitalId === $hospitalId && ((newData.child('patientUid').val() === auth.uid && (!data.exists() || data.child('patientUid').val() === auth.uid)) || auth.token.role === 'staff' || auth.token.role === 'admin')))",
            "hospitalId": { ".validate": "newData.val() === $hospitalId" },
            "patientUid": { ".validate": "newData.isString()" },
            "department": { ".validate": "newData.isString() && newData.val().length > 0" },
            "scheduledAt": { ".validate": "newData.isNumber() && newData.val() > now - 86400000" },
            "durationMin": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 480" },
            "status": { ".validate": "newData.val() === 'scheduled' || newData.val() === 'cancelled' || newData.val() === 'completed'" }
          }
        },
        "appointments_by_patient": {
          "$uid": {
            ".read": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.hospitalId === $hospitalId && ($uid === auth.uid || auth.token.role === 'staff' || auth.token.role === 'admin')))",
            ".write": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.hospitalId === $hospitalId && ($uid === auth.uid || auth.token.role === 'staff' || auth.token.role === 'admin')))",
            "$apptId": {
              "scheduledAt": { ".validate": "newData.isNumber()" },
              "status": { ".validate": "newData.val() === 'scheduled' || newData.val() === 'cancelled' || newData.val() === 'completed'" }
            }
          }
        },
        "visit_plans": {
          "$uid": {
            ".read": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.hospitalId === $hospitalId && ($uid === auth.uid || auth.token.role === 'staff' || auth.token.role === 'admin')))",
            ".write": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.hospitalId === $hospitalId && ($uid === auth.uid || auth.token.role === 'staff' || auth.token.role === 'admin')))",
            "updatedBy": {
              ".validate": "newData.val() === auth.uid"
            },
            "expiresAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 172800000"
            },
            "waypoints": {
              ".validate": "newData.hasChildren()"
            },
            "hospitalId": {
              ".validate": "newData.val() === $hospitalId"
            }
          }
        }
      }
    },

    "audit_logs": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".indexOn": ["timestamp"],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('actorUid').val() === auth.uid"
      }
    },

    "visit_plans": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'staff' || auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'staff' || auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'staff' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "updatedBy": {
          ".validate": "newData.val() === auth.uid"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 172800000"
        },
        "waypoints": {
          ".validate": "newData.hasChildren()"
        }
      }
    },

    "shared_plans": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 1800000"
        }
      }
    },

    "staff_invitations": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.child('email').val() === auth.token.email && newData.child('status').val() === 'accepted' && newData.child('claimedBy').val() === auth.uid))"
      }
    }
  }
}
