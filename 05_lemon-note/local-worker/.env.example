# 로컬 데모 Worker 환경변수 (전부 선택 사항 — 없으면 안전한 기본값으로 동작)

# 서버 포트
PORT=8710

# 로컬 저장소 루트 (원본 음성/내보내기 파일이 여기 저장됨)
LOCAL_STORAGE_ROOT=./data

# 인증 토큰 — 비워두면 데모 모드(인증 없이 로컬에서 바로 동작).
# 값을 넣으면 API가 Authorization: Bearer <token> 을 요구한다.
LOCAL_API_TOKEN=

# Provider 선택 — 기본은 stub(무료, 모델 불필요).
# 실제 로컬 모델로 바꾸려면 faster_whisper / ollama 로 변경.
ASR_PROVIDER=stub          # stub | faster_whisper
SUMMARY_PROVIDER=stub      # stub | ollama

# Stub 파이프라인이 각 단계에서 잠깐 멈추는 시간(초) — 상태 폴링이 눈에 보이게.
# 실제 모델(faster_whisper/ollama)로 쓸 땐 0 권장(실제 처리에 시간이 걸리므로).
STUB_STAGE_DELAY=0.7

# --- 실제 로컬 ASR (ASR_PROVIDER=faster_whisper) ---
# 모델: tiny/base/small/medium/large-v3 (클수록 한국어 품질↑, 속도↓)
#   small  ≈ 484MB, 48초 오디오 ≈ 8초 (한국어 오탈자 다소)
#   medium ≈ 1.5GB, 48초 오디오 ≈ 19초 (한국어 오탈자 거의 없음, 권장·검증됨)
#   large-v3 ≈ 3GB, 품질 최상 / 속도 느림
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu         # Mac은 cpu(int8). CTranslate2가 Metal 미지원.
WHISPER_COMPUTE=int8

# --- 화자 구분(diarization, 선택) ---
# 방식: auto(기본) | none | sherpa | pyannote
#   sherpa   = 오픈 모델, HF 토큰 불필요. `./scripts/setup_diarization.sh` 로 모델 받기(검증됨).
#   pyannote = HF_TOKEN + 게이트 모델 약관 동의 필요.
#   auto     = sherpa 모델 있으면 sherpa, 없고 HF_TOKEN 있으면 pyannote, 아니면 none.
DIARIZER=auto
DIAR_NUM_SPEAKERS=0        # 0=자동. 참석자 수를 알면 지정(예: 3)하면 정확도↑
DIAR_THRESHOLD=0.5         # 자동 분리 민감도(낮을수록 화자 많이 분리)
# pyannote 전용:
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# --- 실제 로컬 요약 (SUMMARY_PROVIDER=ollama) ---
# 사전: brew install ollama && ollama serve && ollama pull <model>
# 모델 후보:
#   gemma4:e4b  ≈ 9.6GB, 128K ctx, M4 Pro ~57tok/s (기본·추론모델)
#   qwen3.5     ≈ 6.6GB, 256K ctx (추론모델)
#   qwen2.5:7b  ≈ 4.7GB (비추론, 안정)  /  gemma2:9b 등
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# 추론 모델의 사고과정 제어: "" 미전송 | false 끄기(권장) | true 켜기.
# gemma4/qwen3.5 → false 권장. qwen2.5 등 미지원 모델 → 반드시 빈 값.
OLLAMA_THINK=false

# Slack Incoming Webhook URL. 비워두면 SLACK_SIMULATE 규칙을 따른다.
SLACK_WEBHOOK_URL=
# Webhook 미설정 시 공유를 성공한 것처럼 시뮬레이션할지(1) 실패로 둘지(0).
SLACK_SIMULATE=1

# --- DB 백엔드 선택 ---
# sqlite(기본, 검증됨) | postgres(Supabase Postgres, psycopg + native 타입).
# postgres 로 바꾸려면 아래 DATABASE_URL(비밀번호 포함)을 채우고 psycopg[binary]를 설치해야 한다.
DB_BACKEND=sqlite
# DB_BACKEND=postgres

# --- Supabase 연결 (server 이전/저장소 전환용) ---
# 아래는 모두 '예시(placeholder)'다. 실제 값은 커밋되는 .env.example 이 아니라
# 로컬 .env(.gitignore)에만 채운다. (publishable 키·URL 은 공개용이지만 템플릿엔 값을 넣지 않는다.)
#   대시보드 Settings > API 에서 Project URL / publishable(anon) key 복사
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX
# 비밀 값 — 반드시 로컬 .env 에만, 절대 커밋 금지:
#   Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=
#   Settings > Database > Connection string(URI, 비밀번호 포함). [YOUR-PASSWORD] 를 본인 비밀번호로.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
