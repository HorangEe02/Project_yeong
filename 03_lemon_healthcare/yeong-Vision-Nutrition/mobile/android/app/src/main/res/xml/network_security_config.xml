<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Network Security Config — Phase M-3-V dev cycle.

  기본: 모든 도메인 HTTPS 강제 (cleartext 차단). production 동작 그대로.
  dev 예외: Android Emulator 가 host 의 http://localhost:8000 또는 8100 을
  http://10.0.2.2:<port> 로 본다. 이 두 도메인만 cleartext 허용 — dev
  백엔드 (uvicorn --reload) 직접 호출 가능.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
