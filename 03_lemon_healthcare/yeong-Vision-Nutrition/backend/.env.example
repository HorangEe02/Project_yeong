# Lemon Healthcare 백엔드 환경 변수 예시.
# 실제 키는 .env 파일에 보관하고 절대 커밋하지 마라(.gitignore 확인).
#
# Phase 00 갱신:
#   - D2 수리: ALLOW_EXTERNAL_LLM 삭제 (외부 LLM은 트랙 B에서 영구 비활성)
#   - D3 수리: Settings.model_config의 extra="forbid"로 unknown env 오타 차단
#   - D4 수리: IMAGE_RETENTION_DAYS 단일 변수를 3개로 분리
#
# Reference:
#   /Users/yeong/.claude/plans/lemon-track-b/phase-00-bootstrap.md Step 3

ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 데이터베이스 / 캐시
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://lemon:devonly@localhost:5432/lemon
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LLM (트랙 B: 로컬 Ollama 단일 채널)
# -----------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b

# -----------------------------------------------------------------------------
# 외부 자격 증명
# -----------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=
MFDS_API_KEY=

# -----------------------------------------------------------------------------
# 게이트 플래그 — docs/17-image-collection-consent-plan.md §9 와 1:1 매핑.
# 운영 환경에서 true 로 변경하려면 docs/17 §8 의 발주처 리뷰 게이트를 통과해야 한다.
# 기본값은 모두 false 이며, 트랙 B MVP 동작에 영향이 없다.
# -----------------------------------------------------------------------------

# 게이트 #1 (Phase 2): Ollama 멀티모달 보조 채널 (Gemma 4 등). 트랙 B에서 비활성.
ENABLE_MULTIMODAL_LLM=false
OLLAMA_MULTIMODAL_MODEL=gemma4:e4b

# 게이트 #2 (Phase 3): YOLO 라벨 영역 검출. 트랙 B에서 비활성.
ENABLE_VISION_CLASSIFIER=false
VISION_CLASSIFIER_MODEL=yolov8n.pt

# 게이트 #3 (Phase 4): 학습 적재 + pgvector. 트랙 B에서 비활성.
ENABLE_IMAGE_LEARNING_PIPELINE=false
ENABLE_PGVECTOR_STORAGE=false
EMBEDDING_MODEL=clip-ViT-B-32

# -----------------------------------------------------------------------------
# 이미지 보유 기간 — D4 수리: docs/17 §5의 4단 보유 정책을 3개 변수로 분리.
# 단일 변수로 한 번에 강제할 수 없으므로 데이터 유형별로 명시한다.
# -----------------------------------------------------------------------------

# 장애 복구 백업용 임시 보유 시간(시). docs/17 §5 임시 분석 이미지. 0 = 분석 직후 삭제.
IMAGE_RETENTION_TEMPORARY_HOURS=0

# 사용자 히스토리 보유 일수. docs/17 §3 동의 매트릭스 항목 2. 기본 90일.
IMAGE_RETENTION_HISTORY_DAYS=90

# 학습 적재 데이터셋 보유 일수. docs/17 §3 항목 4. 게이트 #3 미통과 시 0 고정.
IMAGE_RETENTION_TRAINING_DAYS=0
