# Lemon Healthcare 백엔드 환경 변수 예시.
# 실제 키는 .env 파일에 보관하고 절대 커밋하지 마라(.gitignore 확인).

ENVIRONMENT=development
LOG_LEVEL=INFO

# 데이터베이스 / 캐시
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lemon
REDIS_URL=redis://localhost:6379/0

# LLM (기본: 로컬 Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
ALLOW_EXTERNAL_LLM=false

# 외부 자격 증명
GOOGLE_APPLICATION_CREDENTIALS=
MFDS_API_KEY=

# ---------------------------------------------------------------------------
# 게이트 플래그 — docs/17-image-collection-consent-plan.md §9 와 1:1 매핑.
# 운영 환경에서 true 로 변경하려면 docs/17 §8 의 발주처 리뷰 게이트를 통과해야 한다.
# 기본값은 모두 false 이며, MVP 동작에 영향이 없다.
# ---------------------------------------------------------------------------

# Phase 2 / 게이트 #1: Ollama 멀티모달 보조 채널 (Gemma 4 등)
ENABLE_MULTIMODAL_LLM=false
OLLAMA_MULTIMODAL_MODEL=gemma4:e4b

# Phase 3 / 게이트 #2: YOLO 영양제 라벨 영역 검출
ENABLE_VISION_CLASSIFIER=false
VISION_CLASSIFIER_MODEL=yolov8n.pt

# Phase 4 / 게이트 #3: 학습 적재 파이프라인 + pgvector
ENABLE_IMAGE_LEARNING_PIPELINE=false
ENABLE_PGVECTOR_STORAGE=false
EMBEDDING_MODEL=clip-ViT-B-32

# 이미지 보유 기간(일). 0 = 분석 직후 즉시 삭제(기본).
# docs/17 §3 동의 매트릭스 및 §5 보유 정책을 따른다.
IMAGE_RETENTION_DAYS=0
