{
  "rules": {
    "hospital_index": {
      ".read": true,
      ".write": "auth != null && auth.token.role === 'platformAdmin'"
    },

    "hospitals": {
      "$hospitalId": {
        "profile": {
          ".read": true,
          ".write": "auth != null && auth.token.role === 'platformAdmin'"
        },
        "pois": {
          ".read": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin')",
          ".write": "auth != null && ((auth.token.role === 'admin' && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')"
        },
        "floor-plans": {
          ".read": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin')",
          ".write": "auth != null && ((auth.token.role === 'admin' && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')"
        },
        "departments": {
          ".read": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin')",
          ".write": "auth != null && ((auth.token.role === 'admin' && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')"
        },
        "announcements": {
          ".read": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin')",
          ".write": "auth != null && ((auth.token.role === 'admin' && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')"
        },
        "staff-codes": {
          ".read": "auth != null && auth.token.hospitalId === $hospitalId && (auth.token.role === 'staff' || auth.token.role === 'admin' || auth.token.role === 'platformAdmin')",
          ".write": "auth != null && ((auth.token.role === 'admin' && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')"
        },
        "triage-map": {
          ".read": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin')",
          ".write": "auth != null && ((auth.token.role === 'admin' && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')"
        },
        "wait_queue": {
          ".read": "auth != null && (((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')",
          ".write": "auth != null && (((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')",
          "$department": {
            "$date": {
              "$queueNumber": {
                ".read": "auth != null && data.child('patientUid').val() === auth.uid",
                ".write": "auth != null && !data.exists() && auth.token.hospitalId === $hospitalId && newData.child('patientUid').val() === auth.uid && newData.child('status').val() === 'waiting' && newData.child('hospitalId').val() === $hospitalId && newData.child('department').val() === $department && newData.child('date').val() === $date"
              }
            }
          }
        },
        "wait_queue_by_patient": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'platformAdmin' || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId))",
            ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'platformAdmin' || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId))"
          }
        },
        "wait_queue_counters": {
          ".read": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin')",
          ".write": "auth != null && (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin')",
          "$department": {
            "$date": {
              "current": {
                ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val() + 1)"
              }
            }
          }
        },
        "visit_plans": {
          "$uid": {
            ".read": "auth != null && ((auth.uid === $uid && auth.token.hospitalId === $hospitalId) || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')",
            ".write": "auth != null && ((auth.uid === $uid && auth.token.hospitalId === $hospitalId) || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')",
            "updatedBy": {
              ".validate": "newData.val() === auth.uid"
            },
            "expiresAt": {
              ".validate": "newData.isNumber() && newData.val() <= now + 172800000"
            }
          }
        },
        "appointments": {
          "$appointmentId": {
            ".read": "auth != null && (data.child('patientUid').val() === auth.uid || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')",
            ".write": "auth != null && ((newData.child('patientUid').val() === auth.uid && auth.token.hospitalId === $hospitalId) || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')"
          }
        },
        "appointments_by_patient": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')",
            ".write": "auth != null && ((auth.uid === $uid && auth.token.hospitalId === $hospitalId) || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')"
          }
        }
      }
    },

    "user_fcm_tokens": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'platformAdmin')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "users": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin')",
      ".indexOn": ["role", "hospitalId", "status", "createdAt"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin' || auth.token.role === 'platformAdmin')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'admin' || auth.token.role === 'platformAdmin')",
        "role": {
          ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || (!data.exists() && auth.uid === $uid && (newData.val() === 'patient' || newData.val() === 'staff')))"
        },
        "status": {
          ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || (!data.exists() && auth.uid === $uid && newData.val() === 'active'))"
        },
        "hospitalId": {
          ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || (!data.exists() && auth.uid === $uid))"
        },
        "createdAt": {
          ".write": "auth != null && !data.exists() && auth.uid === $uid"
        }
      }
    },

    "staff_codes": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin')",
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.child('usedBy').exists() && newData.child('usedBy').val() === auth.uid) || auth.token.role === 'admin' || auth.token.role === 'platformAdmin')"
      }
    },

    "sessions": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin')",
      ".indexOn": ["hospitalId", "staffUid", "patientUid"],
      "$sessionId": {
        ".write": "auth != null && (!newData.child('hospitalId').exists() || newData.child('hospitalId').val() === auth.token.hospitalId || auth.token.role === 'platformAdmin')",
        ".read": "auth != null && (data.child('staffUid').val() === auth.uid || data.child('patientUid').val() === auth.uid || (auth.token.role === 'staff' && data.child('hospitalId').val() === auth.token.hospitalId) || (auth.token.role === 'admin' && data.child('hospitalId').val() === auth.token.hospitalId) || auth.token.role === 'platformAdmin')"
      }
    },

    "qr_tokens": {
      "$token": {
        ".write": "auth != null",
        ".read": "auth != null"
      }
    },

    "qr_token_usage": {
      ".read": "auth != null && auth.token.role === 'platformAdmin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'platformAdmin')",
        ".write": "auth != null && auth.uid === $uid",
        "$epochHour": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
        }
      }
    },

    "audit_logs": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin')",
      ".indexOn": ["timestamp", "actorUid", "target"],
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('actorUid').val() === auth.uid"
      }
    },

    "audit_logs_v2": {
      ".read": "auth != null && auth.token.role === 'platformAdmin'",
      "$hospitalId": {
        ".read": "auth != null && (auth.token.role === 'platformAdmin' || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId))",
        ".indexOn": ["timestamp", "actorUid", "target"],
        "$id": {
          ".write": "auth != null && !data.exists() && newData.child('actorUid').val() === auth.uid && ($hospitalId === 'platform' ? auth.token.role === 'platformAdmin' : (auth.token.hospitalId === $hospitalId || auth.token.role === 'platformAdmin'))"
        }
      }
    },

    "visit_plans": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'staff' || auth.token.role === 'admin' || auth.token.role === 'platformAdmin')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'staff' || auth.token.role === 'admin' || auth.token.role === 'platformAdmin')",
        "updatedBy": { ".validate": "newData.val() === auth.uid" },
        "expiresAt": { ".validate": "newData.isNumber() && newData.val() <= now + 172800000" },
        "waypoints": { ".validate": "newData.hasChildren()" }
      }
    },

    "visits": {
      ".read": "auth != null && auth.token.role === 'platformAdmin'",
      "$hospitalId": {
        ".read": "auth != null && (auth.token.role === 'platformAdmin' || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId))",
        ".indexOn": ["patientUid", "status", "type", "scheduledFor"],
        "$visitId": {
          ".read": "auth != null && (data.child('patientUid').val() === auth.uid || ((auth.token.role === 'staff' || auth.token.role === 'admin') && auth.token.hospitalId === $hospitalId) || auth.token.role === 'platformAdmin')",
          ".write": "auth != null && (auth.token.role === 'platformAdmin' || (auth.token.role === 'admin' && auth.token.hospitalId === $hospitalId) || (auth.token.role === 'staff' && auth.token.hospitalId === $hospitalId && data.exists() && newData.child('patientUid').val() === data.child('patientUid').val() && newData.child('hospitalId').val() === data.child('hospitalId').val() && newData.child('type').val() === data.child('type').val()))",
          ".validate": "newData.hasChildren(['patientUid','hospitalId','type','status','zone','createdAt'])",
          "hospitalId": { ".validate": "newData.isString() && newData.val() === $hospitalId" },
          "type": { ".validate": "newData.isString() && (newData.val() === 'outpatient' || newData.val() === 'inpatient' || newData.val() === 'checkup' || newData.val() === 'emergency')" },
          "status": { ".validate": "newData.isString() && (newData.val() === 'scheduled' || newData.val() === 'checked-in' || newData.val() === 'in-progress' || newData.val() === 'completed' || newData.val() === 'cancelled')" },
          "zone": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
          "notes": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" }
        }
      }
    },

    "shared_plans": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        "uid": {
          ".validate": "newData.val() === auth.uid"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 1800000"
        }
      }
    },

    "staff_invitations": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin')",
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'platformAdmin' || (data.child('email').val() === auth.token.email && newData.child('status').val() === 'accepted' && newData.child('claimedBy').val() === auth.uid))"
      }
    },

    "triage_usage": {
      ".read": "auth != null && auth.token.role === 'platformAdmin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'platformAdmin')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "triage_audit": {
      ".read": "auth != null && auth.token.role === 'platformAdmin'",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('actorUid').val() === auth.uid"
      }
    },

    "chat_sessions": {
      "$hospitalId": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'platformAdmin')",
          ".write": "auth != null && (auth.uid === $uid || auth.token.role === 'platformAdmin')",
          ".indexOn": ["lastActivityAt"]
        }
      }
    },

    "chatbot_usage": {
      ".read": "auth != null && auth.token.role === 'platformAdmin'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'platformAdmin')",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
