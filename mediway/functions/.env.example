# ⚠️ 실제 값은 functions/.env (gitignored) 에 저장. 본 파일은 템플릿.
#    Firebase Functions 2세대는 .env 파일을 배포 시 자동 번들/로드함.
#    Kakao·Naver 민감 키는 Secret Manager(defineSecret) 사용 권장 — docs/SECRETS_SETUP.md 참고.

# === Kakao Developers (https://developers.kakao.com) ===
# 주의: 서버 Kakao 키는 이미 Firebase Secret Manager에 저장됨 (Commit 7.5).
#       여기는 로컬 에뮬레이터 개발 편의용 fallback일 뿐.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://your-host/auth/callback/kakao

# === Naver Developers (https://developers.naver.com) ===
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://your-host/auth/callback/naver

# === Google AI Studio / Gemini API (MediWay Hospital Chatbot) ===
# https://aistudio.google.com 에서 발급 (무료 tier 있음).
# MVP 단계에선 .env 직접 주입; 향후 Secret Manager 이관 권장.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CHATBOT_BACKEND=gemini
# Ollama 로컬 LLM은 향후 작업 예정:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma2:9b
